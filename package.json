{
  "name": "@trident/ui",
  "version": "0.2.0",
  "description": "Trident design system: tokens, themes, fonts and React 19 components for the Trident Studio fleet, Williams Media, Portfolio and Quorum.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beauwilliams32/trident-ui.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "fonts",
    "brand",
    "bin",
    "eslint",
    "tokens.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "trident-ui": "./bin/trident-ui.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./islands": {
      "types": "./dist/islands.d.ts",
      "import": "./dist/islands.js"
    },
    "./motion-lite": {
      "types": "./dist/motion-lite.d.ts",
      "import": "./dist/motion-lite.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./marketing": {
      "types": "./dist/marketing.d.ts",
      "import": "./dist/marketing.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./themes/*": "./dist/themes/*",
    "./tokens.json": "./dist/tokens.json",
    "./tokens.mjs": {
      "types": "./dist/tokens.d.mts",
      "import": "./dist/tokens.mjs"
    },
    "./three.mjs": {
      "types": "./dist/three-tokens.d.mts",
      "import": "./dist/three-tokens.mjs"
    },
    "./fonts/*": "./fonts/*",
    "./brand/*": "./brand/*",
    "./eslint": {
      "types": "./eslint/restricted-surfaces.d.ts",
      "import": "./eslint/restricted-surfaces.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:lib": "node scripts/clean.mjs && node scripts/build-tokens.mjs && vite build && tsup && node scripts/build-styles.mjs && node scripts/check-exports.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:lib && npm run size",
    "gate": "npm run check && npm run check:dist && npm run gallery:build && npm run gallery:e2e",
    "check:dist": "node scripts/dist-matches-source.mjs",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "changeset": "changeset",
    "gallery:build": "vite build --config gallery/vite.config.ts",
    "gallery:dev": "vite --config gallery/vite.config.ts",
    "gallery:e2e": "playwright test",
    "gallery:axe": "playwright test gallery/tests/axe.spec.ts",
    "gallery:update": "playwright test gallery/tests/visual.spec.ts --update-snapshots",
    "size": "size-limit"
  },
  "dependencies": {
    "lucide-react": "^1.48.0"
  },
  "peerDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.8.0",
    "cmdk": "^1.1.0",
    "motion": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.0",
    "three": ">=0.180.0 <0.187.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@react-three/drei": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "@radix-ui/react-alert-dialog": {
      "optional": true
    },
    "@radix-ui/react-checkbox": {
      "optional": true
    },
    "@radix-ui/react-context-menu": {
      "optional": true
    },
    "@radix-ui/react-dialog": {
      "optional": true
    },
    "@radix-ui/react-dropdown-menu": {
      "optional": true
    },
    "@radix-ui/react-popover": {
      "optional": true
    },
    "@radix-ui/react-radio-group": {
      "optional": true
    },
    "@radix-ui/react-select": {
      "optional": true
    },
    "@radix-ui/react-slot": {
      "optional": true
    },
    "@radix-ui/react-switch": {
      "optional": true
    },
    "@radix-ui/react-tabs": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@size-limit/esbuild": "^14.1.0",
    "@size-limit/file": "^14.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cmdk": "^1.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.1.0",
    "sonner": "^2.0.8",
    "three": "0.180.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
