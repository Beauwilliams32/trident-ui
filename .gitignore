# Build output. dist/ is committed ONLY on release tags (spec §1): the release job force-adds it
# (git add -f dist) on a detached release commit, so main never carries a stale build.
dist/
node_modules/
coverage/
*.tsbuildinfo
.DS_Store
.vite/
.vitest/
*.log
.env
.env.*
gallery/dist/
test-results/
playwright-report/
blob-report/

# Local secrets and credential material. None of these are tracked today; they are ignored so a
# local file can never be committed by accident.
.npmrc
.netrc
*.pem
*.key
*.p12
*.pfx
.dev.vars
.wrangler/
.vercel/
