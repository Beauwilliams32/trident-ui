      "orange": { "500": "#f97316" },
      "emerald": { "400": "#34d399", "500": "#10b981", "700": "#047857" },
      "violet": { "50": "#f3edff", "100": "#e7dcff", "300": "#b69bff", "400": "#a78bfa", "500": "#7c3aed", "600": "#6d28d9", "700": "#5b21b6" },
