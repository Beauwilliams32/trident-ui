      "playfair-display": "'Playfair Display', 'Playfair Display Fallback', Georgia, 'Times New Roman', serif",
      "system": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', system-ui, sans-serif",
      "system-display": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', system-ui, sans-serif",
      "system-mono": "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace"
    }
  },
  "grid": {
    "columns": "12",
    "content-marketing": "1080px",
    "content-app": "1280px",
    "gutter": "clamp(16px, 4vw, 32px)",
    "gutter-min": "16px",
    "bp-sm": "480px",
    "bp-md": "768px",
    "bp-lg": "1024px",
    "bp-xl": "1280px",
    "gate-3d": "980px",
    "gate-3d-small": "768px",
    "blur-budget": "6"
  },
  "component": {
    "btn-h-sm": "32px",
    "btn-h": "36px",
    "btn-h-lg": "44px",
    "btn-px": "16px",
    "btn-r": "{r-sm}",
    "input-h": "40px",
    "input-r": "{r-sm}",
    "card-r": "{r}",
    "card-pad": "24px",
    "hero-r": "{r-lg}",
    "chip-r": "{r-xs}",
    "kbd-r": "{r-xs}",
    "focus-width": "2px",
    "focus-offset": "2px",
    "target-min": "24px",
    "target-touch": "44px",
    "nav-h": "64px",
    "glass-blur": "14px",
    "glass-saturate": "140%"
  },
  "motion": {
    "duration": {
      "instant": 80,
      "fast": 160,
      "base": 200,
      "page": 260,
      "med": 320,
      "slow": 480,
      "reveal": 600,
      "count": 1100
    },
    "easing": {
      "ease": [0.2, 0.8, 0.2, 1],
      "emph": [0.2, 0, 0, 1],
      "exit": [0.4, 0, 1, 1],
      "inout": [0.4, 0, 0.2, 1],
      "spring": [0.22, 1.2, 0.36, 1],
      "spring-pop": [0.34, 1.4, 0.64, 1]
    },
    "spring": {
      "snappy": { "stiffness": 520, "damping": 38, "mass": 0.8 },
      "smooth": { "stiffness": 300, "damping": 34, "mass": 1 },
      "gentle": { "stiffness": 160, "damping": 26, "mass": 1 }
    },
    "distance": {
      "reveal": 18,
      "stagger": 70,
      "stagger-max": 6,
      "tilt-max": 7,
      "lift": -3
    },
    "rules": {
      "exit-ratio": 0.7,
      "failsafe-reveal-ms": 2500,
      "skeleton-shimmer-max-ms": 1000,
      "reduced-crossfade-max-ms": 150,
      "camera-max-deg": 4,
      "camera-max-units": 0.15,
      "max-flashes-per-second": 3
    }
  },
  "elevation": {
    "light": {
      "e0": "none",
      "e1": "0 1px 2px rgba(15,23,42,.06), 0 0 0 1px var(--ui-line)",
      "e2": "0 18px 48px rgba(15,23,42,.09), 0 2px 10px rgba(15,23,42,.05)",
      "e3": "0 24px 64px rgba(15,23,42,.14), 0 4px 14px rgba(15,23,42,.07)",
      "e4": "0 32px 80px rgba(15,23,42,.20), 0 8px 24px rgba(15,23,42,.10)"
    },
    "dark": {
      "e0": "none",
      "e1": "inset 0 1px 0 var(--ui-specular), 0 0 0 1px var(--ui-glass-edge)",
      "e2": "inset 0 1px 0 var(--ui-specular), 0 0 0 1px var(--ui-glass-edge), 0 16px 40px -16px rgba(0,0,0,.55)",
      "e3": "0 0 0 1px var(--ui-line-strong), 0 24px 64px -12px rgba(0,0,0,.65)",
      "e4": "0 0 0 1px var(--ui-line-strong), 0 32px 80px -12px rgba(0,0,0,.7)"
    }
  },
  "roles": [
    "bg", "bg-2", "surface", "surface-raised",
    "glass", "glass-strong", "glass-edge", "specular",
    "line", "line-strong",
    "ink", "ink-2", "muted",
