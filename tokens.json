  "high-contrast": {
    "$description": "Increase Contrast: @media (prefers-contrast: more) (Apple HIG Accessibility; Radix highContrast). scripts/lib/tokens.mjs#highContrastRoles generates per-theme overrides. Each 'raise' role is mixed toward 'toward' (another role, or 'extreme': white on dark, black on light) until it meets 'min' on every 'on' background. Each 'alias' role takes another role's value as resolved BEFORE raising (hairlines become the old strong line). Each 'solid' role drops its transparency. test/contrast-matrix.test.ts checks 'pairs' in every theme.",
    "on": ["bg", "bg-2", "surface"],
    "raise": [
      { "role": "ink", "min": 7, "toward": "extreme" },
      { "role": "ink-2", "min": 8.5, "toward": "ink" },
      { "role": "muted", "min": 7, "toward": "ink" },
      { "role": "line-strong", "min": 4.5, "toward": "ink" }
    ],
    "alias": { "line": "line-strong", "glass-edge": "line-strong" },
    "solid": { "glass": "surface", "glass-strong": "surface-raised" },
    "pairs": [
      { "fg": "ink", "bg": ["bg", "bg-2", "surface"], "min": 7 },
      { "fg": "ink-2", "bg": ["bg", "bg-2", "surface"], "min": 7 },
      { "fg": "muted", "bg": ["bg", "bg-2", "surface"], "min": 7 },
      { "fg": "line-strong", "bg": ["bg", "bg-2", "surface"], "min": 4.5 },
      { "fg": "line", "bg": ["bg", "bg-2", "surface"], "min": 3 }
    ]
  }
