      "gold": { "300": "#e8b84a", "400": "#c9a84c", "600": "#a17f30" },
      "magenta": { "700": "#5d0045", "900": "#210018" },
      "ink": { "900": "#0b1220", "700": "#1f2a3c", "600": "#334155", "500": "#475569", "400": "#64748b", "300": "#94a3b8" },
      "paper": { "50": "#f7f9fd", "100": "#f1f5fb", "200": "#e2e8f2", "white": "#ffffff" },
      "night": { "900": "#060e1a", "800": "#0b1626", "700": "#13202f" },
      "warning": { "700": "#b54708" },
      "studio-teal": { "50": "#edfaf9", "100": "#d1f3ef", "200": "#a3e7e0", "300": "#75dbd0", "400": "#47cfc1", "500": "#19c3b1", "600": "#15a696", "700": "#118578", "800": "#0c6258", "900": "#083e39" },
      "studio-indigo": { "50": "#f2f3ff", "100": "#dee2ff", "200": "#bdc4ff", "300": "#9da7ff", "400": "#7c89ff", "500": "#5b6cff", "600": "#4d5cd9", "700": "#3e49ad", "800": "#2e3680", "900": "#1d2352" }
    },
    "space": { "0": "0px", "0-5": "2px", "1": "4px", "1-5": "6px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px", "32": "128px" },
    "radius": { "xs": "6px", "sm": "10px", "md": "16px", "lg": "22px", "pill": "999px" },
    "font-size": {
      "2xs": "12px",
      "xs": "13px",
      "sm": "14px",
      "base": "16px",
      "md": "18px",
      "lg": "20px",
      "xl": "clamp(22px, 2vw, 24px)",
      "2xl": "clamp(26px, 3vw, 30px)",
      "3xl": "clamp(30px, 4vw, 38px)",
      "4xl": "clamp(36px, 5.5vw, 48px)",
      "display": "clamp(40px, 6vw, 76px)"
    },
    "line-height": { "base": "1.6", "display": "1.02", "tight": "1.2", "snug": "1.35" },
    "tracking": { "display": "-0.022em", "kicker": "0.14em" },
    "font-weight": { "body": "400", "medium": "500", "display": "600", "kicker": "600", "bold": "700" },
    "measure": { "prose": "68ch" },
    "font-stack": {
      "space-grotesk": "'Space Grotesk', 'Space Grotesk Fallback', ui-sans-serif, system-ui, sans-serif",
      "inter": "'Inter', 'Inter Fallback', ui-sans-serif, system-ui, sans-serif",
      "jetbrains-mono": "'JetBrains Mono', 'JetBrains Mono Fallback', ui-monospace, SFMono-Regular, Menlo, monospace",
      "manrope": "'Manrope', 'Manrope Fallback', ui-sans-serif, system-ui, sans-serif",
