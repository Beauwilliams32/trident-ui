{
  "$description": "@trident/ui design tokens — the single source. scripts/build-tokens.mjs generates dist/tokens.css, dist/themes/*.css, dist/tokens.mjs and dist/three-tokens.mjs (exported as @trident/ui/three.mjs) from this file. Values are spec v1.0 §2–§6 (docs/SPEC.md). A string of the form {role} references another semantic role of the same theme; {p.<ramp>.<step>} references a primitive.",
  "$version": 1,
  "primitives": {
    "color": {
      "navy": { "950": "#04040a", "925": "#070d16", "900": "#0b1422", "850": "#0e1a2b", "800": "#132238", "600": "#5a7591" },
